{
  "name": "family-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "acceptance:run": "node scripts/run-device-acceptance.mjs",
    "acceptance:rollback-byos-image": "node scripts/verify-device-image.mjs",
    "acceptance:rollback-byos-manifest": "node scripts/verify-byos-manifest.mjs",
    "acceptance:rollback-esphome-cursor": "node scripts/verify-esphome-image.mjs",
    "acceptance:validate": "node scripts/validate-acceptance-report.mjs",
    "build": "npm run build:device && npm run build:gmail",
    "build:device": "wrangler deploy --dry-run",
    "build:gmail": "wrangler deploy --dry-run --config wrangler.gmail.toml",
    "check": "npm run validate:production-config && npm run check:device-documentation && npm run typecheck && npm run lint && npm test && npm run build",
    "check:device-documentation": "node scripts/check-device-documentation.mjs",
    "esphome:compile": "uvx --from esphome==2026.9.1 esphome compile esphome/trmnl-daily-brief.yaml",
    "gmail:model:promote": "node scripts/promote-gmail-model.mjs",
    "lint": "eslint .",
    "privacy:gmail": "vitest run test/gmail-privacy.test.ts",
    "preview:render": "tsx scripts/render-local-preview.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate:production-config": "node scripts/validate-production-config.mjs wrangler.toml"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.7.0",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.37.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^24.43.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.148.0"
  }
}
