{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://family-dashboard.invalid/device-acceptance-report.schema.json",
  "title": "Family Dashboard physical device acceptance report",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "recordedAt",
    "target",
    "limitsConfiguration",
    "automated",
    "hardware",
    "issueSummary",
    "battery",
    "discoveredLimits"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "recordedAt": { "type": "string", "format": "date-time" },
    "target": {
      "type": "object",
      "required": ["baseUrl", "panelModel", "firmwareVersion"],
      "properties": {
        "baseUrl": { "type": "string", "format": "uri" },
        "panelModel": { "type": "string", "minLength": 1 },
        "firmwareVersion": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "limitsConfiguration": {
      "const": "config/device-limits.json"
    },
    "automated": {
      "type": "object",
      "required": ["status", "checks"],
      "properties": {
        "status": { "enum": ["pass", "fail"] },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "status"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "status": { "enum": ["pass", "fail"] }
            },
            "additionalProperties": false
          }
        },
        "sequence": { "type": "object" },
        "generation": { "type": "string", "minLength": 1 },
        "physicalSetup": { "$ref": "#/$defs/physicalSetup" },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },
    "hardware": {
      "type": "object",
      "required": ["observations"],
      "properties": {
        "observations": {
          "type": "object",
          "required": [
            "offlineOnePressNavigation",
            "offlineTwoPressViewCycle",
            "scheduledDailyBriefReset",
            "downloadFailurePreservesPair",
            "decodeFailurePreservesPair",
            "unchangedGenerationNoDownload",
            "unchangedGenerationNoPanelRefresh",
            "displayReadability",
            "mechanicalSoundness"
          ],
          "additionalProperties": { "$ref": "#/$defs/observation" }
        }
      },
      "additionalProperties": false
    },
    "issueSummary": {
      "type": "object",
      "required": ["issue", "status", "postedAt"],
      "properties": {
        "issue": { "const": 38 },
        "status": { "enum": ["pending", "posted"] },
        "postedAt": { "type": ["string", "null"], "format": "date-time" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "posted" } },
            "required": ["status"]
          },
          "then": { "properties": { "postedAt": { "type": "string" } } },
          "else": { "properties": { "postedAt": { "const": null } } }
        }
      ],
      "additionalProperties": false
    },
    "battery": { "$ref": "#/$defs/battery" },
    "discoveredLimits": {
      "type": "object",
      "required": [
        "maximumImageBytes",
        "minimumReadableTextPixels",
        "notes"
      ],
      "properties": {
        "maximumImageBytes": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "minimumReadableTextPixels": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "physicalSetup": {
      "type": "object",
      "required": ["status", "checks"],
      "properties": {
        "status": { "enum": ["pass", "fail"] },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "status"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "status": { "enum": ["pass", "fail"] }
            },
            "additionalProperties": false
          }
        },
        "firmwareIdentity": { "type": "string", "minLength": 1 },
        "delivery": { "enum": ["ota", "reset"] },
        "serialReconnects": { "type": "integer", "minimum": 0 },
        "activatedGeneration": { "type": "string", "minLength": 1 },
        "psramHeadroomBytes": { "type": "integer", "minimum": 1 },
        "error": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "pass" } },
            "required": ["status"]
          },
          "then": {
            "required": [
              "firmwareIdentity",
              "delivery",
              "serialReconnects",
              "activatedGeneration",
              "psramHeadroomBytes"
            ]
          },
          "else": { "required": ["error"] }
        }
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "filename",
        "byteSize",
        "dimensions",
        "monochrome",
        "nonBlank"
      ],
      "properties": {
        "filename": { "type": "string", "pattern": "\\.png$" },
        "byteSize": { "type": "integer", "minimum": 1 },
        "dimensions": { "const": "800x480" },
        "monochrome": { "const": true },
        "nonBlank": { "const": true },
        "view": { "enum": ["daily_brief", "calendar"] },
        "generation": { "type": "string", "minLength": 1 },
        "etag": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": ["status", "observedAt", "notes"],
      "properties": {
        "status": { "enum": ["pending", "pass", "fail"] },
        "observedAt": { "type": ["string", "null"], "format": "date-time" },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "enum": ["pass", "fail"] } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "observedAt": { "type": "string", "format": "date-time" },
              "notes": { "type": "string", "minLength": 1 }
            }
          },
          "else": {
            "properties": {
              "observedAt": { "const": null },
              "notes": { "const": "" }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "battery": {
      "type": "object",
      "required": [
        "status",
        "startedAt",
        "endedAt",
        "startChargePercent",
        "endChargePercent",
        "scheduledWakes",
        "shortPresses",
        "recharges",
        "wifiConditions",
        "notes"
      ],
      "properties": {
        "status": { "enum": ["pending", "pass", "fail"] },
        "startedAt": { "type": ["string", "null"], "format": "date-time" },
        "endedAt": { "type": ["string", "null"], "format": "date-time" },
        "startChargePercent": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "endChargePercent": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "scheduledWakes": { "type": ["integer", "null"], "minimum": 0 },
        "shortPresses": { "type": ["integer", "null"], "minimum": 0 },
        "recharges": { "type": ["integer", "null"], "minimum": 0 },
        "wifiConditions": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
